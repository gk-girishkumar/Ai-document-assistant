# ── Database (PostgreSQL with pgvector) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_assistant

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security & Authentication ──
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Uploads ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Embeddings & Vector Search ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── LLM Provider (OpenAI or compatible endpoint, e.g. Ollama, vLLM, LocalAI) ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# ── CORS Allowlist ──
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
